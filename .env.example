# Local secrets - copy to .env and adjust.
#
# Comma-separated list of bearer tokens accepted by the gateway.
# Leave empty to disable authentication (local development only!).
API_KEYS=

# --- Vector database ----------------------------------------------------------
# Pinned Qdrant image tag. Bump deliberately and take a snapshot first:
# upgrading a storage format in place is not guaranteed to be reversible.
# Check the target tag on a volume copy before bumping:
#   python scripts/qdrant_upgrade_check.py --image qdrant/qdrant:<tag> --check both --snapshot backups/<latest>.snapshot
QDRANT_VERSION=v1.20.1

# --- Embeddings ---------------------------------------------------------------
# A single model instance is loaded (inside `api`) and shared with `embedder`.
# Changing it invalidates the index: all documents are re-indexed, and the Qdrant
# collection is recreated automatically when the vector dimension changes
# (Qwen3-Embedding-0.6B: 1024, embeddinggemma-300m: 768).
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B

# cuda | cpu
EMBEDDING_DEVICE=cuda
# float16 | bfloat16 | float32 | auto  (CPU always uses float32)
EMBEDDING_DTYPE=float16
# Texts per embedding request
EMBED_BATCH_SIZE=32
# Encode calls allowed at once. 1 serializes them on the GPU: bulk indexing and
# chat queries queue instead of competing for VRAM. Measured with
# scripts/latency_probe.py; raise it only on a GPU with headroom.
EMBEDDING_MAX_CONCURRENCY=1

# Qwen3-Embedding is instruction-aware: queries are encoded with the model's
# "query" prompt ("Instruct: Given a web search query, retrieve relevant
# passages that answer the query"), documents without it. Empty = no prompt.
EMBEDDING_QUERY_PROMPT=query
# Max tokens per text. The model supports 32k, but 8192 is plenty for the
# 1024-character chunks used by the indexer and keeps VRAM predictable.
EMBEDDING_MAX_SEQ_LENGTH=8192

# --- Hybrid retrieval (dense + BM25) ------------------------------------------
# `api` loads FastEmbed `Qdrant/bm25` (CPU ONNX, ~5 MB, no GPU) next to the
# embedding model, and every chunk is stored twice in the collection: the named
# dense vector `dense` and the sparse vector `bm25` (IDF applied by the Qdrant
# sparse index). `POST /search` queries both branches and fuses the lists with
# RRF. Switching from the pre-hybrid collection (one unnamed vector) recreates
# the collection and re-indexes every file: take a snapshot first
# (`python scripts/qdrant_snapshot.py create`).
#   SEARCH_MODE=dense  - embeddings only, the pre-hybrid behaviour
#   SPARSE_ENABLED=false - BM25 never loads, no `bm25` vectors, dense-only search
SEARCH_MODE=hybrid
SPARSE_ENABLED=true
SPARSE_MODEL=Qdrant/bm25

# Weight of the BM25 branch in RRF (the dense branch is fixed at 1.0) and the
# relative floor: BM25 hits below `SPARSE_MIN_RELATIVE` x the best BM25 score of
# the query are dropped, so weak term overlap is not ranking noise. `min_score`
# applies to the dense cosine score only; a BM25-only hit has no cosine score and
# always passes - that is the point of the sparse branch.
# Measured on this machine (202 points, 5 corpus files): the full grid with the
# source file for every number is `eval/p21-sweep.md`; the runs are committed as
# `eval/p21-search-*.json` (60 single-turn questions, /search, top_k=10) and
# `eval/p21-gateway-*.json` (gateway, top_k=20, rewrite `concat`).
#   dense-only          : recall@10 0.800, MRR@10 0.414, nDCG@10 0.557
#   weight 1.0, floor 0.7 (shipped): recall@10 0.883, MRR@10 0.478, nDCG@10 0.644
#     8 questions dense-only missed are inside the top 10, 4 dropped out of it.
#   weight 1.5          : best MRR (0.487) and nDCG (0.657), loses recall
#   floor 0.5           : recall@10 0.867, recall@5 0.750
# Follow-ups (9 conversations): dense-only recall@10 1.000 / MRR 0.420;
# weight 1.0, floor 0.7 gives 0.889 / 0.453 - the long rewritten follow-up
# `mt-003` is pushed from rank 9 to 13 by BM25 term noise, which is the reranker
# case (P1.1). Both values are read when the container is created, so changing
# them needs `docker compose up -d --force-recreate api`; `/health` reports
# `search_mode`, `sparse_enabled`, `sparse_model`.
SPARSE_WEIGHT=1.0
SPARSE_MIN_RELATIVE=0.7
# ONNX threads for the BM25 model (0 = auto). CPU only, no GPU load.
BM25_THREADS=0

# --- RAG ----------------------------------------------------------------------
# Measured against `eval/questions.jsonl` with `--sweep` (see eval/README.md),
# not guessed. `top_k` is the number of chunks injected; `min_score` is the
# cosine threshold applied to them.
#   RAG_TOP_K=3, RAG_MIN_SCORE=0.5 -> recall@8 0.483, 23% of questions with no
#   context at all.
#   RAG_TOP_K=8, RAG_MIN_SCORE=0.3 -> recall@8 0.783, zero-context 0%.
# Both values are model-dependent: re-run the sweep after any embedding change.
ENABLE_RAG=true
RAG_TOP_K=8
RAG_MIN_SCORE=0.3

# Follow-up query rewriting before retrieval:
#   off    - embed only the last user message
#   concat - prepend recent user turns for short/elliptical questions (default)
#   llm    - ask the upstream model for a standalone query (extra call, falls
#            back to concat when the call fails, to concat when no upstream is set)
# Measured on eval/questions.multiturn.jsonl through the gateway (9 follow-up
# conversations, 20 candidates requested, threshold disabled, one session with the
# mode read back from /health before each run). Committed results:
# eval/multiturn-off.json, eval/multiturn-gateway.json (concat), eval/multiturn-llm.json
#   off:    recall@5 0.667, recall@10 0.778, MRR@10 0.277, nDCG@10 0.392, avg 4.45 s
#   concat: recall@5 0.778, recall@10 1.000, MRR@10 0.420, nDCG@10 0.770, avg 6.08 s
#   llm:    recall@5 0.889, recall@10 1.000, MRR@10 0.514, nDCG@10 0.781, avg 4.09 s
# Concat is the shipped default because it costs nothing: no extra upstream call, and
# it closes the 2 of 9 follow-ups whose raw last message has no expected hit in the
# top ten. Llm ranks higher (at min_score=0.3 it keeps the relevant chunk inside
# top_k=8 for all 9 follow-ups, concat for 8, off for 6) and pays one extra upstream
# call per rewritten follow-up, so it stays opt-in for phrasings concatenation cannot
# resolve. Latency between the modes is dominated by upstream load (the three runs
# measured 4.09-6.08 s average), so compare latency only inside one back-to-back run. Single-turn requests are untouched by any mode: the rewrite
# fires only when there is a history and the last message is short/elliptical.
# Measured on the 60 single-turn questions through the gateway, off and concat give
# identical recall@10 0.800 and MRR@10 0.414 (eval/gateway-singleturn-off.json,
# eval/gateway-singleturn-concat.json). A higher RAG_MIN_SCORE hurts follow-ups most
# (with rewrite off, 0.5 leaves 78% of the follow-ups with no context at all and 0.6
# leaves 100%; with concat, 11% and 67%). The mode is read when the container is
# created, so changing it needs `docker compose up -d --force-recreate gateway`.
RAG_QUERY_REWRITE=concat
# Number of previous user turns to consider
RAG_REWRITE_HISTORY=3
# Timeout in seconds for the llm rewrite call
RAG_REWRITE_TIMEOUT=10

# --- LLM upstream (self-hosted OpenAI-compatible server) ----------------------
# Any server speaking the OpenAI API: vLLM, LM Studio, llama.cpp server, TGI,
# or a cloud endpoint. Usually another machine on the LAN.
#
# With or without the trailing /v1 - both work:
#   http://192.168.1.50:8000
#   http://192.168.1.50:8000/v1
UPSTREAM_BASE_URL=

# Sent to the model server as "Authorization: Bearer <key>".
# Leave empty for servers without auth (LM Studio, llama.cpp by default).
# Agents never see this value.
UPSTREAM_API_KEY=

# Optional extra headers as a JSON object, e.g.
#   UPSTREAM_HEADERS={"X-Title":"rag-gateway"}
UPSTREAM_HEADERS=

# LLM generation timeout in seconds (streaming included)
UPSTREAM_TIMEOUT=600

# DEBUG | INFO | WARNING
LOG_LEVEL=INFO
